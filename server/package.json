{
  "name": "finance-manager-server",
  "version": "1.0.0",
  "description": "Finance Investment Manager — Express + Prisma backend",
  "main": "dist/index.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "prisma generate",
    "test": "vitest run --exclude src/__tests__/auth-integration.test.ts",
    "pretest:integration": "prisma generate",
    "test:integration": "vitest run src/__tests__/auth-integration.test.ts",
    "test:watch": "vitest --exclude src/__tests__/auth-integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/__tests__/auth-integration.test.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed-amanda": "tsx prisma/seed-amanda.ts",
    "db:create-pedro-budget": "tsx src/scripts/create-pedro-budget.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "orders:import-2025": "tsx src/scripts/import-2025-orders.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "yahoo-finance2": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@^10": "11.0.1"
  }
}
