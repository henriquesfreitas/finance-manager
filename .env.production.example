# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain name (or IP if not using a domain). Used for CORS, SSL, nginx.
# For IP-only deployment with self-signed cert, just put the IP here.
DOMAIN=domain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=finance
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_manager

# ── Admin Credentials (first deploy will seed this user) ──────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=finance_session
SESSION_EXPIRY_DAYS=7
