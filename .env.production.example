# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain name (or IP if not using a domain). Used for CORS, SSL, nginx.
# For IP-only deployment with self-signed cert, just put the IP here.
DOMAIN=domain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=finance
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_manager

# ── Admin Credentials (first deploy will seed this user) ──────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=finance_session
SESSION_EXPIRY_DAYS=7

# ── Backup notifications ───────────────────────────────────────────────────────
BACKUP_NOTIFY_EMAIL=you@gmail.com
# Verified sender in Resend — use onboarding@resend.dev for testing,
# or your own domain once verified in the Resend dashboard.
BACKUP_FROM_EMAIL=backup@yourdomain.com
# API key from resend.com — send-only scope, safe to store in .env
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
