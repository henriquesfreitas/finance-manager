# PostgreSQL connection
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_manager
POSTGRES_PORT=5432

# Server DATABASE_URL (used by Prisma)
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_manager"

# Server
PORT=3000
NODE_ENV=development

# Client (Vite prefix required for browser exposure)
VITE_API_BASE_URL=http://localhost:3000

# Admin credentials (used by seed script — never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
SESSION_COOKIE_NAME=finance_session
SESSION_EXPIRY_DAYS=7

# Backup notifications (used by scripts/backup-db.sh)
BACKUP_NOTIFY_EMAIL=you@gmail.com
# Verified sender in Resend — use onboarding@resend.dev for testing,
# or your own domain once verified in the Resend dashboard.
BACKUP_FROM_EMAIL=backup@yourdomain.com
# API key from resend.com — send-only scope, safe to store in .env
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
